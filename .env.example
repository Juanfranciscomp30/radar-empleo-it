# Copia este fichero a .env y cambia los valores. .env no se versiona.

# PostgreSQL (los usa el servicio db y, a partir de ellos, el backend)
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=cambia-esto

# Ingesta manual: true habilita POST /api/ingestas (solo para pruebas en local).
# Déjalo en false; nunca lo actives en una demo pública (ADR-0012)
RADAR_INGESTA_MANUAL_HABILITADA=false
